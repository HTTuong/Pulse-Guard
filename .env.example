# Copy to .env for local runs. .env is never committed.
POSTGRES_PASSWORD=change-me
PULSEGUARD_DATABASE_URL=postgresql+psycopg://pulseguard:change-me@localhost:5434/pulseguard
# Signs staff tokens; at least 32 characters. Make one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
PULSEGUARD_JWT_SECRET=
# Tests create and drop their own databases through this URL.
PULSEGUARD_TEST_ADMIN_URL=postgresql+psycopg://pulseguard:change-me@localhost:5434/postgres
